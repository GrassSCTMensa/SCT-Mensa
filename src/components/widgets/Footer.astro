---
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

export interface Props {
  footNote?: string;
}

const { footNote = '' } = Astro.props;

const orgName = SITE?.name ?? 'Southern Connecticut Mensa';
---

<footer class="relative bg-[#0f2a44] text-white not-prose">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-12">
    <div class="grid grid-cols-12 gap-8">

      <!-- Left -->
      <div class="col-span-12 md:col-span-6">
        <a
          class="inline-block font-semibold text-lg hover:underline"
          href={getHomePermalink()}
        >
          {orgName}
        </a>

        <p class="mt-2 text-sm text-slate-200 max-w-prose">
          The official website of the Southern Connecticut chapter of Mensa.
        </p>

        <div class="mt-4 text-sm text-slate-200">
          <span class="font-medium text-white">Questions?</span>{' '}
          <a class="underline hover:text-white" href="/contact/">Contact us</a>.
        </div>
      </div>

      <!-- Right -->
      <div class="col-span-12 md:col-span-6">
        <div class="grid grid-cols-2 gap-6 text-sm">
          <div>
            <div class="font-medium mb-2 text-white">Explore</div>
            <ul class="space-y-2">
              <li>
                <a class="text-slate-200 hover:text-white hover:underline" href="/who-we-are/">
                  Who We Are
                </a>
              </li>
              <li>
                <a class="text-slate-200 hover:text-white hover:underline" href="/what-we-do/">
                  What We Do
                </a>
              </li>
              <li>
                <a class="text-slate-200 hover:text-white hover:underline" href="/photos-recaps/">
                  Events
                </a>
              </li>
            </ul>
          </div>

          <div>
            <div class="font-medium mb-2 text-white">Join</div>
            <ul class="space-y-2">
              <li>
                <a class="text-slate-200 hover:text-white hover:underline" href="/join-mensa/">
                  Join Mensa
                </a>
              </li>
              <li>
                <a class="text-slate-200 hover:text-white hover:underline" href="/contact/">
                  Contact
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom row -->
    <div class="mt-10 pt-6 border-t border-white/15 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div class="text-xs text-slate-200">
        © {new Date().getFullYear()} Southern Connecticut Mensa. All rights reserved.
      </div>

      {footNote ? (
        <div class="text-xs text-slate-200">
          <Fragment set:html={footNote} />
        </div>
      ) : null}
    </div>
  </div>
</footer>
