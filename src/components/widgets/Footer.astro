---
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';

export interface Props {
  footNote?: string;
  theme?: string;
}

const { footNote = '', theme = 'light' } = Astro.props;

const orgName = SITE?.name ?? 'Southern Connecticut Mensa';
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-12 dark:text-slate-300">
    <div class="grid grid-cols-12 gap-8">
      <!-- Left -->
      <div class="col-span-12 md:col-span-6">
        <a class="inline-block font-semibold text-lg hover:underline" href={getHomePermalink()}>
          {orgName}
        </a>

        <p class="mt-2 text-sm text-muted dark:text-gray-400 max-w-prose">
          The official website of the Southern Connecticut chapter of Mensa.
        </p>

        <div class="mt-4 text-sm text-muted dark:text-gray-400">
          <span class="font-medium text-default dark:text-slate-200">Questions?</span>{' '}
          <a class="hover:underline" href="/contact/">Contact us</a>.
        </div>
      </div>

      <!-- Right -->
      <div class="col-span-12 md:col-span-6">
        <div class="grid grid-cols-2 gap-6 text-sm">
          <div>
            <div class="font-medium mb-2 dark:text-gray-300">Explore</div>
            <ul class="space-y-2">
              <li><a class="text-muted hover:underline dark:text-gray-400" href="/who-we-are/">Who We Are</a></li>
              <li><a class="text-muted hover:underline dark:text-gray-400" href="/what-we-do/">What We Do</a></li>
              <li><a class="text-muted hover:underline dark:text-gray-400" href="/photos-recaps/">Photos &amp; Recaps</a></li>
            </ul>
          </div>

          <div>
            <div class="font-medium mb-2 dark:text-gray-300">Join</div>
            <ul class="space-y-2">
              <li><a class="text-muted hover:underline dark:text-gray-400" href="/join-mensa/">Join Mensa</a></li>
              <li><a class="text-muted hover:underline dark:text-gray-400" href="/events/">Events</a></li>
              <li><a class="text-muted hover:underline dark:text-gray-400" href="/contact/">Contact</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-gray-200 dark:border-slate-800 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div class="text-xs text-muted dark:text-gray-400">
        © {new Date().getFullYear()} {orgName}. All rights reserved.
      </div>

      <div class="text-xs text-muted dark:text-gray-400">
        <Fragment set:html={footNote} />
      </div>
    </div>
  </div>
</footer>
