---
import Layout from '~/layouts/PageLayout.astro';
import heroImage from '~/assets/images/sctmensa-hero-coast-3000x1500.jpg';

const metadata = {
  title: 'Who We Are',
  description: 'Learn about Southern Connecticut Mensa and the community we’re building in Fairfield County.',
};
---

<Layout metadata={metadata}>
  <!-- HERO (full width image + text overlay) -->
  <section class="relative w-full overflow-hidden">
    <div class="relative h-[260px] sm:h-[320px] md:h-[420px]">
      <img
        src={heroImage.src}
        alt="Fairfield County coastline"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/25"></div>

      <div class="absolute inset-0 flex items-end justify-center px-6 pb-10 md:pb-14">
        <h1 class="text-white text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-center drop-shadow">
          Who We Are
        </h1>
      </div>
    </div>
  </section>

  <!-- BODY CONTENT -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <p class="text-lg leading-relaxed text-gray-800 dark:text-slate-200">
      Southern Connecticut Mensa is the local chapter serving Fairfield County and beyond. We’re a community of curious,
      friendly people who enjoy conversation, learning, and spending time with others who “get it.”
    </p>

    <p class="mt-6 text-lg leading-relaxed text-gray-800 dark:text-slate-200">
      Mensa is an international high-IQ society; membership is based on a qualifying score from an accepted test.
      Within that, members bring every kind of background and interest.
    </p>
  </section>
</Layout>
