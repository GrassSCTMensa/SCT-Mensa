---
import Layout from '~/layouts/PageLayout.astro';
import heroImage from '~/assets/images/sctmensa-hero-coast-3000x1500.jpg';

const metadata = {
  title: 'Puzzles',
  description: 'Monthly puzzles from Southern Connecticut Mensa.',
};

// Puzzle #1 data (clues only)
const leftClues = [
  ['A', '0 for last 20'],
  ['B', '30 second spot'],
  ['C', 'Blue Bird Company'],
  ['D', 'BnB guest'],
  ['E', 'C-3PO for one'],
  ['F', 'Cow spread'],
  ['G', 'Dissatisfied sound'],
  ['H', 'Floral prick'],
  ['I', 'Football move'],
  ['J', 'Get their attention'],
  ['K', 'Icelandic feature'],
  ['L', 'Lumberjacks or Guitarists'],
  ['M', 'Make Juicy'],
  ['N', "Pilot's Activity"],
  ['O', 'Needs a cane'],
  ['P', 'New girlfriend'],
  ['Q', 'Periodically 30'],
  ['R', "Pitcher's trick"],
  ['S', 'Proclamation'],
  ['T', 'Put off'],
  ['U', 'Racket game'],
  ['V', 'Starter car'],
  ['W', 'Sucker'],
  ['X', 'Take possession of'],
  ['Y', 'There in your time of need'],
  ['Z', 'Trouble'],
];

const rightClues = [
  '4 on the field',
  'A#1',
  'Assembly Line King',
  'Bambi or Rudolph',
  'Birthday Suit',
  'Cheer',
  'Corporate Structure',
  'Doctors purpose',
  'Fix the first draft',
  "Fortune's partner",
  'Giggle',
  'Group of nations',
  'Holy response',
  'Inverted Valley',
  'Look away',
  'Medical Scare',
  'One night stand',
  'Pageant winner Accessory',
  'Pal',
  'Separates Countries',
  'Some Chowders',
  'Spring sound',
  'Teeth protector',
  'To get by',
  'Chicken from the Bluegrass State',
  'Undecided',
];
---

<Layout metadata={metadata}>
  <!-- HERO -->
  <section class="relative w-full overflow-hidden">
    <div class="relative h-[200px] sm:h-[260px] md:h-[320px]">
      <img
        src={heroImage.src}
        alt="Fairfield County coastline"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/25"></div>

      <div class="absolute inset-0 flex items-end justify-center px-6 pb-10 md:pb-14">
        <h1 class="text-white text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-center drop-shadow">
          Puzzles
        </h1>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <!-- Monthly widget (always stays) -->
    <div class="max-w-3xl mx-auto rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-slate-900/30">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Monthly Puzzles</h2>
      <p class="mt-3 text-lg leading-relaxed text-gray-800 dark:text-slate-200">
        We’ll post a new puzzle each month for anyone who wants a fun challenge. Check back regularly to try the latest
        one — and feel free to share the page with friends who enjoy puzzles.
      </p>
    </div>

    <!-- Puzzle 1 -->
    <div class="mt-12 max-w-5xl mx-auto">
      <h2 class="text-2xl font-semibold text-gray-900 dark:text-white">Puzzle #1 — Letter Removal</h2>

      <div class="mt-4 max-w-3xl">
        <p class="text-lg leading-relaxed text-gray-800 dark:text-slate-200">
          The clues in both columns refer to common words or abbreviations. For each word in the left hand column (1st clue)
          there is a word in the right hand column (2nd clue) with the same spelling except 1 letter of the alphabet has been
          removed. You will remove each letter of the alphabet only once throughout the puzzle.
        </p>

        <p class="mt-4 text-lg leading-relaxed text-gray-800 dark:text-slate-200">
          Here is an example of how it works to get you started:
        </p>

        <div class="mt-3 rounded-2xl border border-slate-200 p-5 shadow-sm dark:border-white/10">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-slate-700 dark:text-slate-200">
            <div>
              <div class="font-semibold text-gray-900 dark:text-white">1st Clue</div>
              <div class="mt-1">Played Basketball — <span class="font-semibold">Balled</span></div>
            </div>
            <div>
              <div class="font-semibold text-gray-900 dark:text-white">2nd Clue</div>
              <div class="mt-1">On point — <span class="font-semibold">Ballet</span></div>
            </div>
          </div>
        </div>

        <p class="mt-4 text-lg leading-relaxed text-gray-800 dark:text-slate-200">
          The left hand words and their right hand counterparts are not in the same order. The matching word can be anywhere
          on the other side.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/puzzles/letter-removal-1-answers/"
            class="inline-flex items-center justify-center rounded-full bg-[#0f2a44] px-6 py-3 text-sm font-semibold text-white hover:bg-[#14395f] transition-colors"
          >
            View Answers
          </a>

          <!-- Optional: works only if you place the PDF in public/puzzles/ -->
          <a
            href="/puzzles/letter-removal-puzzle-1.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-800 hover:bg-slate-50 transition-colors dark:border-white/20 dark:text-white dark:hover:bg-white/10"
          >
            Download Puzzle PDF
          </a>
        </div>
      </div>

      <!-- Two-column clue layout -->
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-slate-900/30">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">1st Clue</h3>
          <ul class="mt-4 space-y-3 text-lg text-gray-800 dark:text-slate-200">
            {leftClues.map(([letter, clue]) => (
              <li>
                <span class="inline-block w-8 font-semibold text-gray-900 dark:text-white">{letter}.</span>
                <span>{clue}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-slate-900/30">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">2nd Clue</h3>
          <ul class="mt-4 space-y-3 text-lg text-gray-800 dark:text-slate-200">
            {rightClues.map((clue, i) => (
              <li>
                <span class="inline-block w-8 font-semibold text-gray-900 dark:text-white">{i + 1}.</span>
                <span>{clue}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
