---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Southern Connecticut Mensa',
  description:
    'Southern Connecticut Mensa — a community of curious, engaged, like-minded people in Fairfield County, Connecticut.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    image={{
      src: '~/assets/images/sctmensa-hero-coast-3000x1500.jpg',
      alt: 'Fairfield County coastline',
    }}
  >
    <Fragment slot="title">
      Southern Connecticut Mensa
    </Fragment>
  </Hero>

  <!-- Intro Content -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <p class="text-lg leading-relaxed text-slate-700">
      Southern Connecticut Mensa is the local Mensa chapter serving Fairfield County, Connecticut.
      Our members come from many backgrounds and walks of life, but what we share is curiosity,
      connection, and a genuine enjoyment of exploring ideas together.
    </p>

    <p class="mt-6 text-lg leading-relaxed text-slate-700">
      We’re a community of like-minded people with shared experiences around being intelligent.
      We get together to have fun, meet new and interesting people, and challenge our minds.
      It’s a welcoming community where it’s okay to be yourself.
    </p>
  </section>
</Layout>
